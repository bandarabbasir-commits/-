# Environment Configuration — Hormozgan Bidar v2 (No Secrets)
# Copy to .env and fill secure production values before running in production.

APP_NAME="هرمزگان بیدار — نسخهٔ ۲"
APP_ENV="development"

# PostgreSQL (use least-privilege app role for runtime and admin role for migrations)
DATABASE_URL="postgresql+asyncpg://hb_app:REPLACE_WITH_APP_DB_PASSWORD@127.0.0.1:5432/hormozgan_bidar"
DATABASE_ADMIN_URL="postgresql+asyncpg://hb_admin:REPLACE_WITH_ADMIN_DB_PASSWORD@127.0.0.1:5432/hormozgan_bidar"

# Security (generate 64+ hex chars in production: openssl rand -hex 32)
SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
SESSION_IDLE_MINUTES="120"
SESSION_ABSOLUTE_HOURS="24"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
TRUSTED_PROXIES="127.0.0.1,::1"

# Initial Admin Seed (NEVER use sample passwords in production)
DEMO_SEED_ENABLED="false"
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD"

# Configurable Scoring & SLA Rules
AUTO_SCORE_DAILY_LOGIN="1"
AUTO_SCORE_TIMELY_ACTION="4"
AUTO_SCORE_SUCCESS="5"
SLA_HOURS_URGENT="2"
SLA_HOURS_MEDIUM="24"
SLA_HOURS_NORMAL="72"
EXPORT_MAX_ROWS="10000"
